#:import IstatistikCard components.istatistik_card.IstatistikCard

<DashboardScreen>

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Periyodik Kontrol Takip"

        ScrollView:

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "15dp"
                padding: "15dp"

                MDGridLayout:
                    cols: 2
                    adaptive_height: True
                    spacing: "12dp"

                    IstatistikCard:
                        id: toplam_card
                        title: "Toplam"
                        icon: "clipboard-text"
                        value: "0"
                        icon_color: "#2196F3"

                    IstatistikCard:
                        id: guvenli_card
                        title: "Geçerli"
                        icon: "check-circle"
                        value: "0"
                        icon_color: "#4CAF50"

                    IstatistikCard:
                        id: yaklasan_card
                        title: "Yaklaşan"
                        icon: "clock-outline"
                        value: "0"
                        icon_color: "#FF9800"

                    IstatistikCard:
                        id: gecmis_card
                        title: "Süresi Geçmiş"
                        icon: "alert-circle"
                        value: "0"
                        icon_color: "#F44336"

                MDLabel:
                    text: "Menü"
                    bold: True
                    font_style: "TitleLarge"

                MDCard:
                    ripple_behavior: True
                    on_release: root.ekipmanlar()

                    MDBoxLayout:
                        padding: "15dp"
                        spacing: "15dp"

                        MDIcon:
                            icon: "clipboard-list"

                        MDLabel:
                            text: "Ekipmanlar"

                MDCard:
                    ripple_behavior: True
                    on_release: root.sorumlular()

                    MDBoxLayout:
                        padding: "15dp"
                        spacing: "15dp"

                        MDIcon:
                            icon: "account-group"

                        MDLabel:
                            text: "Sorumlu Kişiler"

                MDLabel:
                    text: "Yaklaşan Kontroller"
                    bold: True
                    font_style: "TitleLarge"

                MDBoxLayout:
                    id: yaklasan_liste
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: "10dp"
